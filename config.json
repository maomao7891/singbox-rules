{
  "log": {
    "level": "fatal",
    "timestamp": true
  },
  "inbounds": [
    { "type": "mixed", "tag": "mixed-in", "listen": "::", "listen_port": 7890 },
    { "type": "tproxy", "tag": "tproxy-in", "listen": "::", "listen_port": 1536 }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns_fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      },
      {
        "tag": "dns_remote",
        "type": "https",
        "server": "1.1.1.1",
        "detour": "PROXY"
      }
    ],
    "rules": [
      { "query_type": ["A", "AAAA"], "server": "dns_fakeip" }
    ],
    "fakeip": {
      "enabled": true,
      "inet4_range": "198.18.0.0/15",
      "inet6_range": "fc00::/18"
    },
    "strategy": "ipv4_only",
    "independent_cache": true
  },
  "outbounds": [
    {
      "type": "selector",
      "tag": "PROXY",
      "outbounds": ["AUTO", "DIRECT"]
    },
    {
      "type": "urltest",
      "tag": "AUTO",
      "outbounds": [],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    { "type": "direct", "tag": "DIRECT" },
    { "type": "block", "tag": "REJECT" },
    { "type": "dns", "tag": "dns-out" }
  ],
  "route": {
    "rule_set": [
      {
        "tag": "geosite-ads",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs"
      }
    ],
    "rules": [
      { "inbound": ["mixed-in", "tproxy-in"], "action": "sniff" },
      
      // 🛡️ 强力 DNS 劫持
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "port": [53, 853] },
          { "protocol": "dns" }
        ],
        "outbound": "dns-out"
      },

      // 🚫 全量反诈与监控遥测屏蔽
      {
        "domain_suffix": [
          "gjfzpt.cn", "miit.gov.cn", "mps.gov.cn", "chanct.com",
          "fqzpt.com", "fzlm.com", "fanzha.org.cn", "hicore-auth.com",
          "hei-tong.com", "loongteam.com", "cert.org.cn", "ifcert.cn",
          "ifcert.com", "ifcert.org.cn", "cnvd.org.cn", "anva.org.cn",
          "ics-cert.org.cn", "certlab.org", "china-bestmind.com",
          "i-bestmind.com", "t-bestmind.com", "himindtech.com",
          "fhss.com.cn", "hailiangyun.cn"
        ],
        "outbound": "REJECT"
      },

      // ⛔ 强力去广告
      { "rule_set": ["geosite-ads"], "outbound": "REJECT" }
      
      // 注意：这里删除了所有的 DIRECT 规则。
      // 因为路由引擎有 "final": "PROXY" 的兜底设置，
      // 所以除了上面被屏蔽的，剩下的所有请求都会自动进入 PROXY。
    ],
    "auto_detect_interface": true,
    "final": "PROXY"
  }
}
